    Tleaf_kelvin = tleaf + 273.15
    Ko = Ko25 * np.exp((pars['Eo'] / R) * ((1 / 298.15) - (1 / Tleaf_kelvin)))
    Kc = Kc25 * np.exp((pars['Ea'] / R) * ((1 / 298.15) - (1 / Tleaf_kelvin)))
    # Calculate CO2 compensation point (Gamma)
    Gamma = Kc * (1.0 + vpd / pars['O']) / (2.0 * pars['S']) - Ko
    # Calculate electron transport rate (J)
    J = Jmax * np.exp((tleaf * pars['Eaj']) / (R * (tleaf + pars['Eaj'])))
    J = J / (1.0 + np.exp((pars['S'] * tleaf - pars['Hj']) / (R * tleaf)))
    # Calculate Rubisco-limited photosynthesis rate (Ac)
    Vc = Vcmax * np.exp((tleaf * pars['Eav']) / (R * (tleaf + pars['Eav'])))
    Ac = (Vc * (ca - Gamma)) / (ca + Kc * (1.0 + vpd / pars['O']))
    # Calculate light-limited photosynthesis rate (Aj)
    Aj = (J * (ca - Gamma)) / (4.0 * (ca + 2.0 * Gamma))
    # Calculate canopy photosynthesis rate (A)
    A = np.minimum(Ac, Aj) - Rd
    return A
quit()
